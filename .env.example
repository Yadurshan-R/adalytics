# Copy this file to .env and put your own Koios token in it.
# Get a free token at https://www.koios.rest (Profile page).
KOIOS_BASE_URL=https://api.koios.rest/api/v1
KOIOS_API_TOKEN=PASTE_YOUR_KOIOS_TOKEN_HERE

# Optional
PORT=8080
POLL_INTERVAL=60s
HISTORY_DAYS=30
# Koios requests at the same time when loading history (1 to 20). Higher is
# faster until Koios starts timing out (504 in the log); then lower it.
KOIOS_PARALLEL=8
# How much the log shows: debug (every Koios request), info, warn or error
LOG_LEVEL=info
